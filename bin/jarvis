#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="${JARVIS_PROJECT_DIR:-/home/jarvis/jarvis}"
RUNNER="$PROJECT_DIR/run_jarvis.sh"
LOG_FILE="$PROJECT_DIR/logs/jarvis_voice.log"
PROCESS_PATTERN="$PROJECT_DIR/jarvis_voice.py"
LOCK_PATTERN="flock -n /tmp/jarvis-voice.lock"

usage() {
  echo "Usage: jarvis {start|stop|restart|status|logs}"
}

find_pids() {
  {
    pgrep -f "$PROCESS_PATTERN" || true
    pgrep -f "$LOCK_PATTERN" || true
  } | sort -u
}

status() {
  local pids
  pids="$(find_pids)"
  if [ -n "$pids" ]; then
    echo "Jarvis is running:"
    ps -fp $pids
    return 0
  fi

  echo "Jarvis is stopped."
}

start() {
  local pids
  pids="$(find_pids)"
  if [ -n "$pids" ]; then
    echo "Jarvis is already running."
    status
    return 0
  fi

  if [ ! -x "$RUNNER" ]; then
    echo "Jarvis runner is not executable: $RUNNER" >&2
    exit 1
  fi

  mkdir -p "$PROJECT_DIR/logs"
  nohup "$RUNNER" >/dev/null 2>&1 &
  sleep 1
  status
}

stop() {
  local pids
  pids="$(find_pids)"
  if [ -z "$pids" ]; then
    echo "Jarvis is already stopped."
    return 0
  fi

  echo "Stopping Jarvis..."
  kill $pids 2>/dev/null || true
  sleep 1

  pids="$(find_pids)"
  if [ -n "$pids" ]; then
    echo "Jarvis did not stop cleanly; forcing stop..."
    kill -9 $pids 2>/dev/null || true
  fi

  echo "Jarvis stopped."
}

case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  status)
    status
    ;;
  logs)
    touch "$LOG_FILE"
    tail -f "$LOG_FILE"
    ;;
  *)
    usage
    exit 2
    ;;
esac
