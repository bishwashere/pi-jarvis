+static pthread_mutex_t status_lock = PTHREAD_MUTEX_INITIALIZER;
+static char loaded_status[WAKE_SLOTS][640];
+void mww_loaded_json(char *out, size_t cap)
+{
+    pthread_mutex_lock(&status_lock);
+    snprintf(out, cap, "[%s%s%s]", loaded_status[0],
+             loaded_status[0][0] && loaded_status[1][0] ? "," : "", loaded_status[1]);
+    pthread_mutex_unlock(&status_lock);
+}
+static void status_name(const char *in, char *out)
+{
+    /* Worst case six bytes per byte; caller reserves 6 * sizeof(mww_info.name) + 1. */
+    while (*in) {
+        unsigned char c = (unsigned char)*in++;
+        if (c == '"' || c == '\\') { *out++ = '\\'; *out++ = c; }
+        else if (c < 32) { sprintf(out, "\\u%04x", c); out += 6; }
+        else *out++ = c;
+    }
+    *out = 0;
+}
 
