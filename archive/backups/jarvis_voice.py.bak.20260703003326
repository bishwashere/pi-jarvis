import json
import queue
import time

import requests
import sounddevice as sd
from vosk import Model, KaldiRecognizer

from agent_api import ask_pasture
from config import (
    API_ERROR_REPLY,
    API_RETRY_COUNT,
    API_RETRY_REPLY,
    AUDIO_DEVICE,
    COMMAND_FAILED_REPLY,
    COMMAND_RETRY_COUNT,
    DID_NOT_CATCH_REPLY,
    DUPLICATE_WAKE_SECONDS,
    FOLLOWUP_SECONDS,
    GENERIC_ERROR_REPLY,
    MAX_COMMAND_SECONDS,
    SAMPLE_RATE,
    VOSK_MODEL_PATH,
    WAKE_REPLY,
    WAKE_WORDS,
)
from speech import speak


audio_queue = queue.Queue()


def audio_callback(indata, frames, time_info, status):
    if status:
        print("Audio status:", status)

    audio_queue.put(bytes(indata))


def clear_audio_queue():
    while not audio_queue.empty():
        try:
            audio_queue.get_nowait()
        except queue.Empty:
            break


def listen_for_command(model: Model, seconds: int = MAX_COMMAND_SECONDS) -> str:
    recognizer = KaldiRecognizer(model, SAMPLE_RATE)

    clear_audio_queue()

    start = time.time()
    last_speech_time = time.time()
    last_partial = ""
    final_parts = []

    print("Listening for command...")

    while time.time() - start < seconds:
        try:
            data = audio_queue.get(timeout=0.5)
        except queue.Empty:
            continue

        if recognizer.AcceptWaveform(data):
            result = json.loads(recognizer.Result())
            text = result.get("text", "").strip()

            if text:
                final_parts.append(text)
                last_speech_time = time.time()
                print("final part:", text)
        else:
            partial = json.loads(recognizer.PartialResult()).get("partial", "").strip()

            if partial and partial != last_partial:
                print("partial:", partial)
                last_partial = partial
                last_speech_time = time.time()

        # If we heard finalized speech and then got a short silence, stop.
        if final_parts and time.time() - last_speech_time > 0.7:
            break

    final = json.loads(recognizer.FinalResult()).get("text", "").strip()

    if final:
        final_parts.append(final)

    # If Vosk only had partial text but no final text, use the partial.
    if not final_parts and last_partial:
        return last_partial

    return " ".join(final_parts).strip()


def get_command_with_retries(model: Model) -> str:
    for attempt in range(COMMAND_RETRY_COUNT):
        command = listen_for_command(model, seconds=MAX_COMMAND_SECONDS)

        if command:
            return command

        if attempt < COMMAND_RETRY_COUNT - 1:
            speak(COMMAND_FAILED_REPLY)

    return ""


def ask_and_speak(user_text: str) -> bool:
    for attempt in range(API_RETRY_COUNT):
        try:
            result = ask_pasture(user_text)

            reply = result.get("reply", "")
            continue_listening = bool(result.get("continue_listening", False))

            speak(reply)
            return continue_listening

        except requests.exceptions.RequestException as e:
            print("API error:", e)

            if attempt < API_RETRY_COUNT - 1:
                speak(API_RETRY_REPLY)
                continue

            speak(API_ERROR_REPLY)
            return False

        except Exception as e:
            print("Unexpected error:", e)
            speak(GENERIC_ERROR_REPLY)
            return False

    return False


def handle_conversation(model: Model):
    speak(WAKE_REPLY)

    command = get_command_with_retries(model)

    if not command:
        speak(DID_NOT_CATCH_REPLY)
        return

    print("Command:", command)

    should_continue = ask_and_speak(command)

    while True:
        # If the server explicitly asks to continue, listen longer.
        # Otherwise, listen briefly for a natural follow-up.
        listen_seconds = MAX_COMMAND_SECONDS if should_continue else FOLLOWUP_SECONDS

        followup = listen_for_command(model, seconds=listen_seconds)

        if not followup:
            print("No follow-up. Returning to wake word mode.")
            break

        print("Follow-up:", followup)

        should_continue = ask_and_speak(followup)


def main():
    print("Loading Vosk model...")
    model = Model(VOSK_MODEL_PATH)

    wake_recognizer = KaldiRecognizer(model, SAMPLE_RATE)

    print("Jarvis voice loop running.")
    print(f'Say one of these to wake: {", ".join(WAKE_WORDS)}')
    print("Press Ctrl+C to stop.")

    last_trigger_time = 0

    with sd.RawInputStream(
        samplerate=SAMPLE_RATE,
        blocksize=4000,
        device=AUDIO_DEVICE,
        dtype="int16",
        channels=1,
        callback=audio_callback,
    ):
        while True:
            data = audio_queue.get()

            if wake_recognizer.AcceptWaveform(data):
                result = json.loads(wake_recognizer.Result())
                heard = result.get("text", "").lower().strip()

                if heard:
                    print("Heard:", heard)

                if any(wake in heard for wake in WAKE_WORDS):
                    now = time.time()

                    # Prevent duplicate triggers.
                    if now - last_trigger_time < DUPLICATE_WAKE_SECONDS:
                        continue

                    last_trigger_time = now

                    handle_conversation(model)

                    # Clear any audio left over from TTS playback.
                    clear_audio_queue()

                    # Reset wake recognizer after conversation and follow-ups.
                    wake_recognizer = KaldiRecognizer(model, SAMPLE_RATE)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStopped.")
