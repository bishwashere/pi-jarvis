# Copy to .env and set your local Pasture address. Never commit the filled file.
JARVIS_API_BASE_URL=http://pasture.example.invalid:1235/v1/agents/jarvis
# Keep local-only until a unique token and trusted LAN access are configured.
JARVIS_COMMAND_SERVER_HOST=127.0.0.1
JARVIS_COMMAND_SERVER_TOKEN=
# Optional: first create and edit echo_devices.json from the example inventory.
# JARVIS_ECHO_DEVICES_PATH=echo_devices.json
